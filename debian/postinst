#!/bin/sh
set -e

# Reload systemd and update library cache
if [ -d /run/systemd/system ]; then
    ldconfig
    systemctl daemon-reload
    # Recreate enablement links when upgrading from the legacy /opt package,
    # whose unit lived under /etc/systemd/system.
    systemctl reenable badge-launcher.service
    # Reload udev rules for the hardware
    if command -v udevadm > /dev/null; then
        udevadm control --reload-rules && udevadm trigger
    fi
fi

exit 0
